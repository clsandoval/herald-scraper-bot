# Local product template. uv run --env-file .env ... loads it explicitly.
# Never commit filled credentials. Neither mode uses an LLM key.
DISCORD_BOT_TOKEN=
STRATZ_API_TOKEN=

# Stable scheduled reports only: destination text channel and durable receipts.
DISCORD_CHANNEL_ID=
HERALD_REPORT_DB=herald-reports.db

# Experimental menu only: shared SQLite path for ingest and menu.
HERALD_DB=herald.db
